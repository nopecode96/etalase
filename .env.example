# Server & Port
NODE_ENV="development"
PORT=3005
N8N_HOST_PORT=5678
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Database (Using user, password, port, dan nama DB PostgreSQL local development)
DB_HOST_PORT=5435
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_NAME="etalase_online"
DATABASE_URL="postgresql://postgres:your_password@localhost:5435/etalase_online?schema=public"

# Auth.js Secret (For local development, you can use a random string. In production, use a secure secret.)
AUTH_SECRET=""

# Google OAuth & API (optional for local, fill if you need to test Google login)
GOOGLE_API_KEY=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mabes Super Admin
MABES_ADMIN_EMAIL="admin@etalase.online"
MABES_ADMIN_PASSWORD=""
SUPER_ADMIN_EMAILS="admin@etalase.online"

# Borderpay Payment Gateway (Test Mode)
BORDERPAY_ENV="test"
BORDERPAY_API_BASE_URL=""
BORDERPAY_TEST_API_KEY=""
BORDERPAY_TEST_WEBHOOK_KEY=""
BORDERPAY_WEBHOOK_URL=""

# PayPal Gateway (Sandbox / Test Mode)
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_SANDBOX_EMAIL=""
PAYPAL_WEBHOOK_URL=""

# WhatsApp Automation (opsional)
FONNTE_TOKEN=""
